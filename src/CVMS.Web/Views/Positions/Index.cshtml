@model IReadOnlyList<CVMS.Application.Positions.PositionListItem>

@{
    ViewData["Title"] = "Positions";

    var canManage =
        User.IsInRole("Recruiter") ||
        User.IsInRole("Administrator");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Positions</h1>

        <p class="text-muted mb-0">
            Available CV positions.
        </p>
    </div>

    @if (canManage)
    {
        <a class="btn btn-primary"
           asp-action="Create">
            Create Position
        </a>
    }
</div>

@if (canManage)
{
    <div class="d-flex gap-2 mb-3">
        <button id="editButton"
                type="button"
                class="btn btn-outline-primary"
                disabled>
            Edit
        </button>

        <button id="duplicateButton"
                type="button"
                class="btn btn-outline-secondary"
                disabled>
            Duplicate
        </button>

        <button id="deleteButton"
                type="button"
                class="btn btn-outline-danger"
                disabled>
            Delete
        </button>
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No positions have been created yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
            <tr>
                @if (canManage)
                {
                    <th style="width: 40px"></th>
                }

                <th>Title</th>
                <th>Description</th>
                <th>Attributes</th>
                <th>Max Projects</th>
            </tr>
            </thead>

            <tbody>
            @foreach (var position in Model)
            {
                <tr>
                    @if (canManage)
                    {
                        <td>
                            <input type="radio"
                                   name="selectedPosition"
                                   value="@position.Id"
                                   class="form-check-input position-selector" />
                        </td>
                    }

                    <td>
                        <strong>@position.Title</strong>
                    </td>

                    <td>
                        @position.ShortDescription
                    </td>

                    <td>
                        @position.AttributeCount
                    </td>

                    <td>
                        @position.MaximumProjects
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (canManage)
{
    <form id="duplicateForm"
          asp-action="Duplicate"
          method="post">

        <input id="duplicateId"
               type="hidden"
               name="id" />
    </form>

    <form id="deleteForm"
          asp-action="Delete"
          method="post">

        <input id="deleteId"
               type="hidden"
               name="id" />
    </form>

    <script>
        const selectors =
            document.querySelectorAll(".position-selector");

        const editButton =
            document.getElementById("editButton");

        const duplicateButton =
            document.getElementById("duplicateButton");

        const deleteButton =
            document.getElementById("deleteButton");

        const duplicateForm =
            document.getElementById("duplicateForm");

        const deleteForm =
            document.getElementById("deleteForm");

        const duplicateId =
            document.getElementById("duplicateId");

        const deleteId =
            document.getElementById("deleteId");

        let selectedId = null;

        selectors.forEach(selector => {
            selector.addEventListener("change", () => {
                selectedId = selector.value;

                editButton.disabled = false;
                duplicateButton.disabled = false;
                deleteButton.disabled = false;
            });
        });

        editButton.addEventListener("click", () => {
            if (!selectedId) {
                return;
            }

            window.location.href =
                `/Positions/Edit/${selectedId}`;
        });

        duplicateButton.addEventListener("click", () => {
            if (!selectedId) {
                return;
            }

            duplicateId.value = selectedId;
            duplicateForm.submit();
        });

        deleteButton.addEventListener("click", () => {
            if (!selectedId) {
                return;
            }

            if (!confirm(
                "Are you sure you want to delete this position?")) {
                return;
            }

            deleteId.value = selectedId;
            deleteForm.submit();
        });
    </script>
}