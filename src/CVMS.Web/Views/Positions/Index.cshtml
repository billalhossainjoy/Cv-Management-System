@model IReadOnlyList<CVMS.Application.Positions.PositionListItem>

@{
    ViewData["Title"] = "Positions";
}



<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Positions</h1>
        <p class="text-muted mb-0">
            Manage cv templates available to candidates.
        </p>
    </div>
    <a class="btn-primary btn" asp-action="Create">
        Create Position
    </a>
</div>


<div class="d-flex gap-2 mb-3">
    <button id="editButton"
            type="button"
            class="btn btn-outline-primary"
            disabled>
        Edit
    </button>

    <button id="duplicateButton"
            type="button"
            class="btn btn-outline-secondary"
            disabled>
        Duplicate
    </button>

    <button id="deleteButton"
            type="button"
            class="btn btn-outline-danger"
            disabled>
        Delete
    </button>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        no position have create yet
    </div>
}
else
{
    <div>
        <table>
            <thead>
            <tr>
                <th style="width: 40px"></th>
                <th>Title</th>
                <th>Description</th>
                <th>Attributes</th>
                <th>Max Projects</th>
            </tr>
            </thead>
            
            <tbody>
            @foreach (var position in Model)
            {
                <tr>
                    <td>
                        <input type="radio" name="selectedPosition" value="@position.Id" class="form-check-input"/>
                    </td>
                    <td>
                        <strong>@position.Title</strong>
                    </td>
                    <td>
                        <strong>@position.ShortDescription</strong>
                    </td>
                    <td>
                        <strong>@position.AttributeCount</strong>
                    </td>
                    <td>
                        <strong>@position.MaximumProjects</strong>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}