@model CVMS.Web.Models.Position.CreatePositionViewModel

<h1>Create Position</h1>

<form asp-action="Create"
      method="post"
      class="d-flex flex-column gap-3">

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div style="max-width: 700px">
        <label asp-for="Title"
               class="form-label"></label>

        <input asp-for="Title"
               class="form-control" />

        <span asp-validation-for="Title"
              class="text-danger"></span>
    </div>

    <div style="max-width: 700px">
        <label asp-for="ShortDescription"
               class="form-label"></label>

        <textarea asp-for="ShortDescription"
                  rows="4"
                  class="form-control"></textarea>
    </div>

    <div style="max-width: 300px">
        <label asp-for="MaximumProjects"
               class="form-label">
            Maximum Projects
        </label>

        <input asp-for="MaximumProjects"
               type="number"
               min="0"
               class="form-control" />

        <span asp-validation-for="MaximumProjects"
              class="text-danger"></span>
    </div>

    <div>
        <h2 class="h5">
            Position Attributes
        </h2>

        <table class="table align-middle">
            <thead>
            <tr>
                <th style="width: 80px">Include</th>
                <th>Name</th>
                <th>Category</th>
                <th style="width: 100px">Required</th>
            </tr>
            </thead>

            <tbody>
            @for (var i = 0; i < Model.Attributes.Count; i++)
            {
                <tr>
                    <td>
                        <input type="hidden"
                               asp-for="Attributes[i].AttributeId" />

                        <input asp-for="Attributes[i].Selected"
                               class="form-check-input" />
                    </td>

                    <td>
                        @Model.Attributes[i].Name
                    </td>

                    <td>
                        @Model.Attributes[i].Category
                    </td>

                    <td>
                        <input asp-for="Attributes[i].IsRequired"
                               class="form-check-input" />
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="d-flex gap-2">
        <button type="submit"
                class="btn btn-primary">
            Create
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>
    </div>
</form>