@model CVMS.Web.Models.Auth.LoginViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="">
    <div class="mx-auto w-100 d-flex align-items-center flex-column " style="max-width: 580px">
        <h1 class="">Login</h1>
        <p class="">welcome to JobQL</p>
        <form asp-action="Login" method="post" class="w-100">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="d-flex flex-column">
                <label asp-for="Email"></label>
                <input class="form-control" asp-for="Email"/>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="d-flex flex-column">
                <label asp-for="Password"></label>
                <input class="form-control" asp-for="Password"/>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            
            <div>
                <input asp-for="RememberMe" />
                <label asp-for="RememberMe"></label>
            </div>

            <button type="submit" class="btn btn-primary d-block w-100 mt-3">Login</button>
            <p class="text-center">I have not any account, <a asp-action="Register" class="text-primary text-decoration-underline">Register now</a>.</p>

        </form>
    </div>
</div>