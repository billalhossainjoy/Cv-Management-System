@using CVMS.Domain.Attributes
@model CVMS.Web.Models.Attribute.EditAttributeViewModel

@{
    ViewData["Title"] = "Edit Attribute";
}

<h1>Edit Attribute</h1>

@if (Model.IsBuiltIn)
{
    <div class="alert alert-info">
        This is a built-in attribute and cannot be deleted.
    </div>
}

<form asp-action="Edit"
      method="post"
      style="max-width: 600px"
      class="d-flex flex-column gap-3">

    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div>
        <label asp-for="Name"
               class="form-label"></label>

        <input asp-for="Name"
               class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Description"
               class="form-label"></label>

        <textarea asp-for="Description"
                  rows="4"
                  class="form-control"></textarea>

        <span asp-validation-for="Description"
              class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Category"
               class="form-label"></label>

        <select asp-for="Category"
                asp-items="Html.GetEnumSelectList<AttributeCategory>()"
                class="form-select">
        </select>
    </div>

    <div>
        <label asp-for="Type"
               class="form-label"></label>

        <select asp-for="Type"
                asp-items="Html.GetEnumSelectList<AttributeType>()"
                class="form-select">
        </select>
    </div>

    <div class="d-flex gap-2">
        <button type="submit"
                class="btn btn-primary">
            Save
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>
    </div>
</form>