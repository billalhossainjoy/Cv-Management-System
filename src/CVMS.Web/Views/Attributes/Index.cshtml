@model IReadOnlyList<CVMS.Application.Attribute.AttributeListItem>

@{
    ViewData["Title"] = "Attribute Library";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Attribute Library</h1>
        <p class="text-muted">
            Manage reusable profile and CV attributes.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Create Attribute
    </a>
</div>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No attributes found.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Type</th>
                <th>Description</th>
                <th>Built-in</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>

            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <strong>@item.Name</strong>
                    </td>

                    <td>@item.Category</td>

                    <td>@item.Type</td>

                    <td>@item.Description</td>

                    <td>
                        @if (item.IsBuiltIn)
                        {
                            <span class="badge text-bg-secondary">
                                Built-in
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                Custom
                            </span>
                        }
                    </td>

                    <td class="text-end">
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>

                        @if (!item.IsBuiltIn)
                        {
                            <form asp-action="Delete"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  class="d-inline">

                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Delete this attribute?')">
                                    Delete
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
