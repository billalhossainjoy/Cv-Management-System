@model IReadOnlyList<CVMS.Web.Models.Project.ProjectListItemViewModel>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>My Projects</h1>

    <a asp-action="Create"
       class="btn btn-primary">
        Add Project
    </a>
</div>

<table class="table">
    <thead>
    <tr>
        <th>Name</th>
        <th>Period</th>
        <th></th>
    </tr>
    </thead>

    <tbody>
    @foreach (var project in Model)
    {
        <tr>
            <td>@project.Name</td>

            <td>
                @project.StartDate.ToString("MMM yyyy")
                -
                @(project.EndDate?.ToString("MMM yyyy") ?? "Present")
            </td>

            <td class="text-end">
                <a asp-action="Edit"
                   asp-route-id="@project.Id"
                   class="btn btn-sm btn-outline-primary">
                    Edit
                </a>

                <form asp-action="Delete"
                      asp-route-id="@project.Id"
                      method="post"
                      class="d-inline">

                    <button type="submit"
                            class="btn btn-sm btn-outline-danger">
                        Delete
                    </button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>