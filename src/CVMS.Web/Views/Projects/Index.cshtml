<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>My Projects</h1>

    <a asp-action="Create"
       class="btn btn-primary">
        Add Project
    </a>
</div>

<table class="table">
    <thead>
    <tr>
        <th>Name</th>
        <th>Period</th>
    </tr>
    </thead>

    <tbody>
    @foreach (var project in Model)
    {
        <tr>
            <td>@project.Name</td>

            <td>
                @project.StartDate.ToString("MMM yyyy")
                -
                @(project.EndDate?.ToString("MMM yyyy") ?? "Present")
            </td>
        </tr>
    }
    </tbody>
</table>