@model CVMS.Web.Models.Home.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

<div class="mb-4">
    <h1>CV Management System</h1>

    <p class="text-muted">
        Manage professional profiles, projects, attributes and positions.
    </p>
</div>

<div class="row g-3 mb-5">

    <div class="col-12 col-md-6 col-lg-3">
        <div class="border rounded p-3 h-100">
            <div class="text-muted">
                Positions
            </div>

            <div class="fs-2 fw-bold">
                @Model.PositionCount
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <div class="border rounded p-3 h-100">
            <div class="text-muted">
                Candidates
            </div>

            <div class="fs-2 fw-bold">
                @Model.CandidateCount
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <div class="border rounded p-3 h-100">
            <div class="text-muted">
                Recruiters
            </div>

            <div class="fs-2 fw-bold">
                @Model.RecruiterCount
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <div class="border rounded p-3 h-100">
            <div class="text-muted">
                Attributes
            </div>

            <div class="fs-2 fw-bold">
                @Model.AttributeCount
            </div>
        </div>
    </div>

</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">
        Latest Positions
    </h2>

    <a asp-controller="Positions"
       asp-action="Index"
       class="btn btn-outline-primary">
        View All
    </a>
</div>

@if (Model.LatestPositions.Count == 0)
{
    <div class="alert alert-info">
        No positions are available yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">

            <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Attributes</th>
                <th>Max Projects</th>
            </tr>
            </thead>

            <tbody>
            @foreach (var position in Model.LatestPositions)
            {
                <tr>
                    <td>
                        <strong>
                            @position.Title
                        </strong>
                    </td>

                    <td>
                        @position.ShortDescription
                    </td>

                    <td>
                        @position.AttributeCount
                    </td>

                    <td>
                        @position.MaximumProjects
                    </td>
                </tr>
            }
            </tbody>

        </table>
    </div>
}